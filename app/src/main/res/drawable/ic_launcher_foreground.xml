<?xml version="1.0" encoding="utf-8"?>
<!--
  MirrorDrive launcher foreground — "a screen radiating its signal."
  Reuses the app's RippleSignalView motif: a mirror-cyan glass screen at the
  centre with two concentric ripple rings expanding and fading outward, over a
  soft cyan core glow. All art sits inside the central ~66dp safe zone (radius
  <= 33 from the 54,54 centre), so it survives both square and circle masks.
  Colours from Palette.kt: MIRROR #55D6D0, SILVER #AEB9C0.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft cyan core glow behind the mark (echoes RippleSignalView's glowPaint). -->
    <path android:pathData="M21,54 a33,33 0 1 0 66,0 a33,33 0 1 0 -66,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="33">
                <item android:offset="0.0" android:color="#3355D6D0"/>
                <item android:offset="0.6" android:color="#1A55D6D0"/>
                <item android:offset="1.0" android:color="#0055D6D0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer ripple ring — faintest, the signal losing energy as it spreads. -->
    <path
        android:pathData="M23,54 a31,31 0 1 0 62,0 a31,31 0 1 0 -62,0"
        android:strokeColor="#4D55D6D0"
        android:strokeWidth="2"
        android:strokeLineCap="round"/>

    <!-- Inner ripple ring — brighter, closer to the source. -->
    <path
        android:pathData="M31,54 a23,23 0 1 0 46,0 a23,23 0 1 0 -46,0"
        android:strokeColor="#B255D6D0"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"/>

    <!-- The mirror: a landscape glass screen, cyan with a top-to-bottom sheen. -->
    <path android:pathData="M44,43.5 H64 a5,5 0 0 1 5,5 V59.5 a5,5 0 0 1 -5,5 H44 a5,5 0 0 1 -5,-5 V48.5 a5,5 0 0 1 5,-5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="43.5"
                android:endX="54" android:endY="64.5"
                android:startColor="#72E5E0"
                android:endColor="#43C6C0"/>
        </aapt:attr>
    </path>

    <!-- Faint silver specular glint in the upper-left of the glass. -->
    <path
        android:pathData="M43.5,50 L49,45.5"
        android:strokeColor="#66AEB9C0"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"/>

</vector>
